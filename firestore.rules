rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isCooperativeHead(coopId) {
      return isAuthenticated() && (
        isAdmin() ||
        (getUserData().role == 'cooperative_head' && (
          getUserData().cooperativeId == coopId || 
          getUserData().cooperativeId == null || 
          !('cooperativeId' in getUserData())
        ))
      );
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read basic user profile
      allow read: if isAuthenticated();

      // Users can write their own profile during registration/onboarding
      // But cannot elevate role to admin or approve their own verification
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        // Cooperative Head can verify workers in their cooperative
        (getUserData().role == 'cooperative_head' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cooperativeId', 'membershipStatus', 'verificationStatus', 'availableForJobs', 'updatedAt'])) ||
        // Worker updating their own details, but cannot self-approve or elevate to admin
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
         request.resource.data.verificationStatus != 'verified' &&
         request.resource.data.membershipStatus != 'approved'
        )
      );
      allow delete: if isAdmin();
    }

    // Cooperatives Collection
    match /cooperatives/{cooperativeId} {
      // Anyone authenticated can read active cooperatives
      allow read: if isAuthenticated();
      // Admin can manage cooperatives, Head can update their own
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isCooperativeHead(cooperativeId);

      // Cooperative workers subcollection
      match /workers/{workerId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isCooperativeHead(cooperativeId);
      }
    }

    // Services Collection
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Cooperative Join Requests Collection
    match /cooperative_join_requests/{requestId} {
      // Worker can read their own request; Cooperative Head can read requests for their cooperative; Admin can read all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.workerId == request.auth.uid ||
        resource.data.cooperativeHeadId == request.auth.uid ||
        isCooperativeHead(resource.data.cooperativeId) ||
        getUserData().role == 'cooperative_head'
      );

      // Worker can create their own request with status "pending"
      allow create: if isAuthenticated() && 
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Cooperative Head can approve, reject, or request more info
      // Worker can resubmit when status was rejected or more_information_required
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isCooperativeHead(resource.data.cooperativeId) ||
        resource.data.cooperativeHeadId == request.auth.uid ||
        getUserData().role == 'cooperative_head' ||
        (resource.data.workerId == request.auth.uid && request.resource.data.status == 'pending')
      );

      allow delete: if isAdmin();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        getUserData().role == 'worker' ||
        isCooperativeHead(resource.data.cooperativeId) ||
        getUserData().role == 'cooperative_head'
      );

      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        getUserData().role == 'worker' ||
        isCooperativeHead(resource.data.cooperativeId) ||
        getUserData().role == 'cooperative_head'
      );

      allow delete: if isAdmin();
    }
  }
}
